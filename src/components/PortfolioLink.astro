---
interface Props {
  title: string,
  description: string,
  href: string,
  domain?: string,
  class?: string,
}

const { title, description, href, class: className } = Astro.props
const domain = Astro.props.domain || URL.parse(href)?.host.replace(/^www\./, '')
---

<li class="group relative flex gap-4 sm:gap-0 sm:flex-col sm:items-start">
  <div class={`relative flex-none z-10 flex size-12 items-center justify-center rounded-full bg-white ring-1 shadow-md shadow-zinc-800/5 ring-zinc-900/5 dark:border dark:border-zinc-700/50 dark:bg-zinc-800 dark:ring-0 ${className}`}>
    <slot />
  </div>
  <div class="flex flex-col sm:flex-auto">
    <h2 class="sm:mt-6 text-base font-semibold text-zinc-800 dark:text-zinc-100">
      <div class="absolute -inset-x-4 -inset-y-6 z-0 scale-95 bg-zinc-50 opacity-0 transition group-hover:scale-100 group-hover:opacity-100 sm:-inset-x-6 sm:rounded-2xl dark:bg-zinc-800/50"></div>
      <a {href} target="_blank">
        <span class="absolute -inset-x-4 -inset-y-6 z-20 sm:-inset-x-6 sm:rounded-2xl"></span>
        <span class="relative z-10">{title}</span>
      </a>
    </h2>
    <p class="sm:flex-auto z-10 mt-2 text-sm text-zinc-600 dark:text-zinc-400">{description}</p>
    <p class="z-10 mt-4 sm:mt-6 flex items-center text-sm font-medium text-zinc-400 transition group-hover:text-sky-500 dark:text-zinc-200">
      <svg aria-hidden="true" class="size-6 flex-none">
        <use xlink:href="#icon-link"></use>
      </svg>
      <span class="ms-2">{domain}</span>
    </p>
  </div>
</li>
