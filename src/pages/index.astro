---
import { getCollection } from "astro:content"
import FormattedDate from "../components/FormattedDate.astro"
import Job from "../components/Job.astro"
import PortfolioLink from "../components/PortfolioLink.astro"
import Layout from "../layouts/Layout.astro";

import { CupSoda, Play, SquareCheckBig, Zap } from "@lucide/astro";

const articles = await getCollection("articles")
articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const data = {
  title: "Alan Hardman — Technologies Portfolio",
  description: "Explore my portfolio, a seasoned software engineer with over 10 years experience. Discover innovative projects, open-source code & valuable skills in adaptability & collaboration.",
  schema: {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Alan Hardman",
    "jobTitle": "Software Engineer",
    "email": "alan@phpizza.com",
    "sameAs": [
      "https://github.com/Alanaktion",
      "https://www.linkedin.com/in/alan-hardman-017a3637/",
      "https://twitter.com/alanaktion",
      "https://x.com/alanaktion"
    ]
  }
}
---

<Layout {data} header={false}>

  <!-- Bio -->
  <div class="max-w-2xl">
    <div class="mb-9">
      <picture>
        <source srcset="/me26.avif" type="image/avif">
        <img class="rounded-full bg-black object-cover size-16" src="/me26.webp" alt="Photo of Alan.">
      </picture>
    </div>

    <h1 class="text-4xl font-bold tracking-tight text-zinc-800 sm:text-5xl dark:text-zinc-100">Building bridges between people and technology</h1>
    <p class="mt-6 text-base text-zinc-600 dark:text-zinc-400 text-pretty">I’m Alan, a seasoned software engineer with over a decade of experience in delivering high-quality projects. I bring a unique blend of technical expertise and passion for innovation.</p>

    <!-- Socials -->
    <div class="mt-6 flex gap-4">
      <a class="group -m-2 p-2" title="Follow on GitHub" href="https://github.com/Alanaktion">
        <span class="sr-only">Follow on GitHub</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="size-6 fill-zinc-500 transition group-hover:fill-zinc-800 dark:fill-zinc-400 dark:group-hover:fill-zinc-200">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.475 2 2 6.588 2 12.253c0 4.537 2.862 8.369 6.838 9.727.5.09.687-.218.687-.487 0-.243-.013-1.05-.013-1.91C7 20.059 6.35 18.957 6.15 18.38c-.113-.295-.6-1.205-1.025-1.448-.35-.192-.85-.667-.013-.68.788-.012 1.35.744 1.538 1.051.9 1.551 2.338 1.116 2.912.846.088-.666.35-1.115.638-1.371-2.225-.256-4.55-1.14-4.55-5.062 0-1.115.387-2.038 1.025-2.756-.1-.256-.45-1.307.1-2.717 0 0 .837-.269 2.75 1.051.8-.23 1.65-.346 2.5-.346.85 0 1.7.115 2.5.346 1.912-1.333 2.75-1.05 2.75-1.05.55 1.409.2 2.46.1 2.716.637.718 1.025 1.628 1.025 2.756 0 3.934-2.337 4.806-4.562 5.062.362.32.675.936.675 1.897 0 1.371-.013 2.473-.013 2.82 0 .268.188.589.688.486a10.039 10.039 0 0 0 4.932-3.74A10.447 10.447 0 0 0 22 12.253C22 6.588 17.525 2 12 2Z"></path>
        </svg>
      </a>
      <a class="group -m-2 p-2" title="Follow on LinkedIn" href="https://www.linkedin.com/in/alan-hardman-017a3637/">
        <span class="sr-only">Follow on LinkedIn</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="size-6 fill-zinc-500 transition group-hover:fill-sky-600 dark:fill-zinc-400 dark:group-hover:fill-sky-500">
          <path d="M18.335 18.339H15.67v-4.177c0-.996-.02-2.278-1.39-2.278-1.389 0-1.601 1.084-1.601 2.205v4.25h-2.666V9.75h2.56v1.17h.035c.358-.674 1.228-1.387 2.528-1.387 2.7 0 3.2 1.778 3.2 4.091v4.715zM7.003 8.575a1.546 1.546 0 01-1.548-1.549 1.548 1.548 0 111.547 1.549zm1.336 9.764H5.666V9.75H8.34v8.589zM19.67 3H4.329C3.593 3 3 3.58 3 4.297v15.406C3 20.42 3.594 21 4.328 21h15.338C20.4 21 21 20.42 21 19.703V4.297C21 3.58 20.4 3 19.666 3h.003z"></path>
        </svg>
      </a>
      <a class="group -m-2 p-2" title="Follow on X" href="https://x.com/alanaktion">
        <span class="sr-only">Follow on X</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="size-6 fill-zinc-500 transition group-hover:fill-black dark:fill-zinc-400 dark:group-hover:fill-zinc-100">
          <path d="M13.3174 10.7749L19.1457 4H17.7646L12.7039 9.88256L8.66193 4H4L10.1122 12.8955L4 20H5.38119L10.7254 13.7878L14.994 20H19.656L13.3171 10.7749H13.3174ZM11.4257 12.9738L10.8064 12.0881L5.87886 5.03974H8.00029L11.9769 10.728L12.5962 11.6137L17.7652 19.0075H15.6438L11.4257 12.9742V12.9738Z"></path>
        </svg>
      </a>
    </div>
  </div>

  <!-- Portfolio -->
  <div class="mx-auto w-full max-w-7xl mt-16 sm:mt-32">
    <header class="max-w-2xl">
      <h2 class="text-2xl font-bold tracking-tight text-zinc-800 sm:text-3xl dark:text-zinc-100">My works speak for me.</h2>
      <p class="mt-6 text-base text-zinc-600 dark:text-zinc-400 text-pretty">This portfolio is a reflection of my work as a software engineer, where I’ve pushed myself to create something new and valuable. Some were built with the collaboration of a team, while others are solo projects. Many of these projects are open-source, so take a look at the code and see how you can use them yourself.</p>
    </header>

    <!-- Link icon symbol -->
    <svg aria-hidden="true" class="absolute invisible">
      <symbol id="icon-link" viewBox="0 0 24 24">
        <path d="M15.712 11.823a.75.75 0 1 0 1.06 1.06l-1.06-1.06Zm-4.95 1.768a.75.75 0 0 0 1.06-1.06l-1.06 1.06Zm-2.475-1.414a.75.75 0 1 0-1.06-1.06l1.06 1.06Zm4.95-1.768a.75.75 0 1 0-1.06 1.06l1.06-1.06Zm3.359.53-.884.884 1.06 1.06.885-.883-1.061-1.06Zm-4.95-2.12 1.414-1.415L12 6.344l-1.415 1.413 1.061 1.061Zm0 3.535a2.5 2.5 0 0 1 0-3.536l-1.06-1.06a4 4 0 0 0 0 5.656l1.06-1.06Zm4.95-4.95a2.5 2.5 0 0 1 0 3.535L17.656 12a4 4 0 0 0 0-5.657l-1.06 1.06Zm1.06-1.06a4 4 0 0 0-5.656 0l1.06 1.06a2.5 2.5 0 0 1 3.536 0l1.06-1.06Zm-7.07 7.07.176.177 1.06-1.06-.176-.177-1.06 1.06Zm-3.183-.353.884-.884-1.06-1.06-.884.883 1.06 1.06Zm4.95 2.121-1.414 1.414 1.06 1.06 1.415-1.413-1.06-1.061Zm0-3.536a2.5 2.5 0 0 1 0 3.536l1.06 1.06a4 4 0 0 0 0-5.656l-1.06 1.06Zm-4.95 4.95a2.5 2.5 0 0 1 0-3.535L6.344 12a4 4 0 0 0 0 5.656l1.06-1.06Zm-1.06 1.06a4 4 0 0 0 5.657 0l-1.061-1.06a2.5 2.5 0 0 1-3.535 0l-1.061 1.06Zm7.07-7.07-.176-.177-1.06 1.06.176.178 1.06-1.061Z" fill="currentColor"></path>
      </symbol>
    </svg>

    <div class="mt-16 sm:mt-20">
      <ul role="list" class="grid grid-cols-1 gap-12 lg:gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
        <PortfolioLink title="Stride Events" description="Complete solution for event ticketing and registration." href="https://www.strideevents.com" class="text-yellow-600">
          <svg viewBox="0 0 174.5 100.6" class="fill-current size-7">
            <path d="M148.4 88c-8.5-.3-15.1 6.2-23 8.5-4 2-27.2 11-40.4 12.2-7.7.9-15.8 3.1-20.4 9.9-5 5.4-7.8 14.8-16.5 15-11.2 1-19.6-9-22.5-18.8.5-5.3-7.7-15.4-9.4-6-.8 5.5.7 10.4 3.8 15 1.8 3.4 9.5 12.8 16.5 13.7 4 1 17 1.3 21.1-3.9 4.4-1.1 12.6-14.3 12.3-7.5-4.4 3-8.7 18.3-12.2 22a51.5 51.5 0 0 0-18.2 28.2c-1.3 3.6-5.9 10-5.2 11.3.8 1 2.2 1.5 4.8-2 4.7-5.6 7-12.8 12.2-18 4.1-6 10-10.3 16.3-13.7 10.2-6.6 20.7-13.9 26.7-24.7 6 .6 14-.5 21.4-2.5 14 1.2 27.1-5.8 27.3-3.2 1.9 1.5 11.6 10.5 1.6 10.4-3.3 1.8-8.4.5-10.8 3-1.2 5.8 8 3.5 11.7 2.5 4.7-.4 11.2-5 11.5-10.2 4.4-1.8 14.7-5 13.8 4.1-.7 8.3 11.3 5.3 8-2-1.2-6-7-9.3-12.2-11.6-4.5-2.8-11.3 5-13.9 0-3-4 11.4-10.8 17.5-8.6 3.7.3 10 .4 11.2.5-1.3.6-.1 1.6.9 1.3 6.6 1 6.5-6.8 7.8-10.2-4.3-3.4-5.1-10.3-11.7-10 .8-3.2-6.3-1.3-7.7-.6-.5 2.2-1.2-.6 1-1.5-7.9 1-15.4-2.5-23.3-2.7z" transform="translate(-16 -87.9)" />
          </svg>
        </PortfolioLink>
        <PortfolioLink title="Digicert CertCentral" description="A comprehensive platform for managing digital certificates." href="https://www.digicert.com/certcentral" class="text-[#0174C3]">
          <svg viewBox="0 0 34 33" class="fill-current size-7">
            <path d="M9 32c-2-.39-4.2-1.2-5.7-2l-.93-.52 1.3.2c.73.11 1.8.17 2.4.14 1-.06 2.2-.71 2.4-1.3.05-.15-.89-1.3-2.1-2.6-2.5-2.7-3.6-4.3-4.6-6.7-1.5-3.5-1.8-6.5-1.1-10 .43-2.2 1.5-5.1 2.3-6l.54-.66-.17.66a20 20 0 0 0-.32 2.3c-.14 1.5-.1 1.7.46 2.3.34.36.71.65.83.65s1.4-.88 2.8-1.9c6.7-5.1 12-6.7 18-5.6 2.3.47 5.1 1.5 6.1 2.3.6.45.58.46-.76.28-1.8-.23-3.6.07-4.3.71-.52.52-.52.53 2 3.7 2.7 3.4 4.4 6.3 5 8.7.58 2.2.53 6.4-.11 8.9-.42 1.6-1.7 4.7-1.9 4.7-.03 0-.07-.74-.09-1.7a5.77 5.77 0 0 0-1.1-3.6c-.2-.3-.79.1-2.9 1.9-4.5 3.9-8.2 5.5-13 5.6-1.7.06-3.5-.05-4.6-.27zm9.5-4.9c2.7-.85 5.7-3.1 8.7-6.7 1.3-1.5 1.3-1.5 1.1-2.9-.25-2.1-1.7-4.7-4.7-8.4-1.5-1.8-2.7-3.5-2.8-3.6-.23-.57-2.5-.37-4.7.43-2.5.86-4.7 2.3-8.4 5.3-2.8 2.3-2.8 2.3-2.3 4.8.53 2.8 1.9 5.1 5.4 8.6l3.2 3.3 1.5-.18a18 18 0 0 0 3-.68z" />
          </svg>
        </PortfolioLink>
        <PortfolioLink title="RUVI" description="Health-focused e-commerce with affiliate program and memberships." href="https://www.goruvi.com" class="text-zinc-800 dark:text-zinc-400">
          <CupSoda stroke-width="1.5" class="size-8" />
        </PortfolioLink>
        <PortfolioLink title="Thrive Life" description="Freeze-dried food store, recipe site, and direct sales dashboard." href="https://www.thrivelife.com" class="text-[#7ac143]">
          <svg stroke-width="2" class="size-8 stroke-current fill-none overflow-visible" viewBox="0 0 31.75 31.75">
            <path d="M18 14.38h4.63M13.66 30.9A15.21 15.21 0 0 1 .78 14.06a15.21 15.21 0 1 1 15.1 17.03V14.32s.23-6.45-7.75-6.45c0 0-.67 6.52 7.68 6.52"></path>
          </svg>
        </PortfolioLink>
        <PortfolioLink title="Phproject" description="A high performance, full-featured project management system." href="https://www.phproject.org" class="text-sky-600 dark:text-teal-400">
          <svg class="stroke-current fill-none size-7" viewBox="0 0 24 24" stroke-width="2">
            <path d="M21 10.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h12.5"></path>
            <path d="m9 11 3 3L22 4"></path>
          </svg>
        </PortfolioLink>
        <PortfolioLink title="Lime Testing Suite" description="Test case library and software testing suite, making app testing easy." href="http://github.com/Alanaktion/lime-testing" class="text-lime-500">
          <SquareCheckBig stroke-width="1.5" class="size-8" />
        </PortfolioLink>
        <PortfolioLink title="MyTube" description="Self-hosted video archive web app, with mobile and TV app integrations." href="https://github.com/Alanaktion/mytube" class="text-blue-500">
          <Play class="stroke-none fill-current size-8 relative left-px" />
        </PortfolioLink>
        <PortfolioLink title="Zippa Builder" description="Documentation publishing platform for web, mobile, and print." href="https://web.archive.org/web/20210226213120/https://getzippa.com/" class="text-teal-500">
          <Zap class="stroke-none fill-current size-8" />
        </PortfolioLink>
        <PortfolioLink title="StructHub" description="Mobile app for instruction and assembly manuals." href="https://web.archive.org/web/20180816221417/https://www.structhub.com/" class="text-blue-500">
          <svg class="fill-current size-8" viewBox="0 0 12 21">
            <path d="M5 1c.56-1 1.5-1 2 0l4.4 8c.56 1 .56 2.7 0 3.7l-4.4 8c-.56 1-1.5 1-2 0l-4.4-8C.04 11.7.04 10 .6 9zm2.3 6H4.6c-.44 0-.97.31-1.2.69l-1.2 2.1c-.29.5-.29 1.3 0 1.8l1.2 2.1c.22.38.75.69 1.2.69h2.7c.44 0 .97-.31 1.2-.69l1.2-2.1c.29-.5.29-1.3 0-1.8l-1.2-2.1C8.28 7.31 7.75 7 7.3 7z"></path>
          </svg>
        </PortfolioLink>
