  <div class="mx-auto w-full max-w-7xl mt-16 sm:mt-32">
    <div class="mx-auto grid max-w-xl grid-cols-1 gap-y-20 lg:max-w-none lg:grid-cols-2">
      <!-- Skills -->
      <div class="max-w-2xl lg:mt-10">
        <h2 class="text-2xl font-bold tracking-tight text-zinc-800 sm:text-3xl dark:text-zinc-100">Private projects, public skills.</h2>
        <p class="mt-6 text-base text-zinc-600 dark:text-zinc-400 text-pretty">While many of my contributions are publicly visible, a significant portion of my software development works remain confidential. Through these experiences, I’ve built a wide range of skills essential for high-performing software engineers, including adaptability, collaboration, and effective team management.</p>
        <ul class="mt-6 flex gap-2 flex-wrap text-sm text-zinc-800 *:px-2 *:py-0.5 *:bg-linear-to-b *:from-white *:to-zinc-100 *:border *:border-zinc-100 dark:*:border-zinc-700 dark:*:from-zinc-700 dark:*:to-zinc-900 dark:text-zinc-200 *:rounded-sm" aria-label="Skill list" role="list">
          <li>project management</li>
          <li>e-commerce</li>
          <li>mobile apps</li>
          <li>leadership</li>
          <li>agile methodologies</li>
          <li>cybersecurity</li>
          <li>database administration</li>
          <li>kubernetes</li>
          <li>cloud computing</li>
          <li>machine learning</li>
          <li>business intelligence</li>
          <li>analytics</li>
          <li>point-of-sale</li>
          <li>operations</li>
          <li>pci compliance</li>
        </ul>
      </div>

      <div class="space-y-10 lg:pl-16 xl:pl-24">
        <!-- Work history -->
        <div class="rounded-2xl border border-zinc-100 p-6 dark:border-zinc-700/40">
          <h2 class="flex items-center text-sm font-semibold text-zinc-900 dark:text-zinc-100">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-6 w-6 flex-none">
              <path d="M2.75 9.75a3 3 0 0 1 3-3h12.5a3 3 0 0 1 3 3v8.5a3 3 0 0 1-3 3H5.75a3 3 0 0 1-3-3v-8.5Z" class="fill-zinc-100 stroke-zinc-400 dark:fill-zinc-800 dark:stroke-zinc-500"></path>
              <path d="M3 14.25h6.249c.484 0 .952-.002 1.316.319l.777.682a.996.996 0 0 0 1.316 0l.777-.682c.364-.32.832-.319 1.316-.319H21M8.75 6.5V4.75a2 2 0 0 1 2-2h2.5a2 2 0 0 1 2 2V6.5" class="stroke-zinc-400 dark:stroke-zinc-500"></path>
            </svg>
            <span class="ms-3">Work</span>
          </h2>
          <ol class="mt-6 space-y-4">
            <Job company="Stride Events" role="Web Developer" start="2025" end="current">
              <svg viewBox="0 0 174.5 100.6" class="text-yellow-600 fill-current size-6">
                <path d="M148.4 88c-8.5-.3-15.1 6.2-23 8.5-4 2-27.2 11-40.4 12.2-7.7.9-15.8 3.1-20.4 9.9-5 5.4-7.8 14.8-16.5 15-11.2 1-19.6-9-22.5-18.8.5-5.3-7.7-15.4-9.4-6-.8 5.5.7 10.4 3.8 15 1.8 3.4 9.5 12.8 16.5 13.7 4 1 17 1.3 21.1-3.9 4.4-1.1 12.6-14.3 12.3-7.5-4.4 3-8.7 18.3-12.2 22a51.5 51.5 0 0 0-18.2 28.2c-1.3 3.6-5.9 10-5.2 11.3.8 1 2.2 1.5 4.8-2 4.7-5.6 7-12.8 12.2-18 4.1-6 10-10.3 16.3-13.7 10.2-6.6 20.7-13.9 26.7-24.7 6 .6 14-.5 21.4-2.5 14 1.2 27.1-5.8 27.3-3.2 1.9 1.5 11.6 10.5 1.6 10.4-3.3 1.8-8.4.5-10.8 3-1.2 5.8 8 3.5 11.7 2.5 4.7-.4 11.2-5 11.5-10.2 4.4-1.8 14.7-5 13.8 4.1-.7 8.3 11.3 5.3 8-2-1.2-6-7-9.3-12.2-11.6-4.5-2.8-11.3 5-13.9 0-3-4 11.4-10.8 17.5-8.6 3.7.3 10 .4 11.2.5-1.3.6-.1 1.6.9 1.3 6.6 1 6.5-6.8 7.8-10.2-4.3-3.4-5.1-10.3-11.7-10 .8-3.2-6.3-1.3-7.7-.6-.5 2.2-1.2-.6 1-1.5-7.9 1-15.4-2.5-23.3-2.7z" transform="translate(-16 -87.9)"/>
              </svg>
            </Job>
            <Job company="Consultant work" role="Software Contractor" start="2023" end="2025">
              <svg class="text-zinc-500 dark:text-zinc-400 fill-none stroke-current size-6" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="m11 17 2 2a1 1 0 1 0 3-3"></path>
                <path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"></path>
                <path d="m21 3 1 11h-2"></path>
                <path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"></path>
                <path d="M3 4h8"></path>
              </svg>
            </Job>
            <Job company="Digicert" role="Senior Software Engineer" start="2021" end="2023">
              <svg viewBox="0 0 34 33" class="text-[#0174C3] fill-current size-6">
                <path d="M9 32c-2-.39-4.2-1.2-5.7-2l-.93-.52 1.3.2c.73.11 1.8.17 2.4.14 1-.06 2.2-.71 2.4-1.3.05-.15-.89-1.3-2.1-2.6-2.5-2.7-3.6-4.3-4.6-6.7-1.5-3.5-1.8-6.5-1.1-10 .43-2.2 1.5-5.1 2.3-6l.54-.66-.17.66a20 20 0 0 0-.32 2.3c-.14 1.5-.1 1.7.46 2.3.34.36.71.65.83.65s1.4-.88 2.8-1.9c6.7-5.1 12-6.7 18-5.6 2.3.47 5.1 1.5 6.1 2.3.6.45.58.46-.76.28-1.8-.23-3.6.07-4.3.71-.52.52-.52.53 2 3.7 2.7 3.4 4.4 6.3 5 8.7.58 2.2.53 6.4-.11 8.9-.42 1.6-1.7 4.7-1.9 4.7-.03 0-.07-.74-.09-1.7a5.77 5.77 0 0 0-1.1-3.6c-.2-.3-.79.1-2.9 1.9-4.5 3.9-8.2 5.5-13 5.6-1.7.06-3.5-.05-4.6-.27zm9.5-4.9c2.7-.85 5.7-3.1 8.7-6.7 1.3-1.5 1.3-1.5 1.1-2.9-.25-2.1-1.7-4.7-4.7-8.4-1.5-1.8-2.7-3.5-2.8-3.6-.23-.57-2.5-.37-4.7.43-2.5.86-4.7 2.3-8.4 5.3-2.8 2.3-2.8 2.3-2.3 4.8.53 2.8 1.9 5.1 5.4 8.6l3.2 3.3 1.5-.18a18 18 0 0 0 3-.68z"></path>
              </svg>
            </Job>
            <Job company="StructHub" role="CTO/Co-Founder" start="2019" end="2021">
              <svg class="fill-current text-blue-500 size-7" viewBox="0 0 12 21">
                <path d="M5 1c.56-1 1.5-1 2 0l4.4 8c.56 1 .56 2.7 0 3.7l-4.4 8c-.56 1-1.5 1-2 0l-4.4-8C.04 11.7.04 10 .6 9zm2.3 6H4.6c-.44 0-.97.31-1.2.69l-1.2 2.1c-.29.5-.29 1.3 0 1.8l1.2 2.1c.22.38.75.69 1.2.69h2.7c.44 0 .97-.31 1.2-.69l1.2-2.1c.29-.5.29-1.3 0-1.8l-1.2-2.1C8.28 7.31 7.75 7 7.3 7z"></path>
              </svg>
            </Job>
            <Job company="Thrive Life" role="Senior Software Engineer" start="2013" end="2019">
              <svg stroke-width="2" class="size-7 stroke-[#7ac143] fill-none overflow-visible" viewBox="0 0 31.75 31.75">
                <path d="M18 14.38h4.63M13.66 30.9A15.21 15.21 0 0 1 .78 14.06a15.21 15.21 0 1 1 15.1 17.03V14.32s.23-6.45-7.75-6.45c0 0-.67 6.52 7.68 6.52"></path>
              </svg>
            </Job>
          </ol>
        </div>

        <!-- Articles -->
        <div class="rounded-2xl border border-zinc-100 p-6 dark:border-zinc-700/40">
          <div class="flex items-center">
            <h2 class="flex items-center text-sm font-semibold text-zinc-900 dark:text-zinc-100">
              <svg class="size-6 stroke-zinc-400 dark:stroke-zinc-500 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m18 5-2.414-2.414A2 2 0 0 0 14.172 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2" class="fill-zinc-100 dark:fill-zinc-800"></path>
                <path d="M21.378 12.626a1 1 0 0 0-3.004-3.004l-4.01 4.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"></path>
                <path d="M8 18h1"></path>
              </svg>
              <span class="ml-3">Articles</span>
            </h2>
            <a class="group relative ms-auto flex items-center text-sm text-sky-500 font-medium" href="/articles/">
              <div class="absolute -inset-2 bg-zinc-50 opacity-0 transition group-hover:scale-100 group-hover:opacity-100 sm:rounded-xl dark:bg-zinc-800/50 -z-1"></div>
              View all
              <svg viewBox="0 0 16 16" fill="none" class="ml-1 -mr-1 size-4 stroke-current">
                <path d="M6.75 5.75 9.25 8l-2.5 2.25" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>

          <div class="flex flex-col gap-4 mt-6">
            {articles.map(({id, data}) => (
              <article class="group relative px-1">
                <div class="absolute -inset-2 bg-zinc-50 opacity-0 transition group-hover:scale-100 group-hover:opacity-100 sm:rounded-xl dark:bg-zinc-800/50 -z-1"></div>
                <a href={`/articles/${id}/`} class="text-sm font-medium text-zinc-900 dark:text-zinc-100">
                  <span class="absolute inset-0"></span>
                  {data.short_title || data.title}
                </a>
                <div class="mt-1 flex items-center justify-between">
                  <FormattedDate class="text-xs text-zinc-500 dark:text-zinc-400" date={data.date} />
                  <div aria-hidden="true" class="flex items-center text-sm text-sky-500 font-medium">
                    Read article
                    <svg viewBox="0 0 16 16" fill="none" class="ml-1 -mr-1 size-4 stroke-current">
                      <path d="M6.75 5.75 9.25 8l-2.5 2.25" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>

    </div>
  </div>

</Layout>
